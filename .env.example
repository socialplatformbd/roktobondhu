# Copy this file to ".env" and fill in your own Firebase project values.
# These are PUBLIC client identifiers (not secrets), but you should still
# only use values from a Firebase project you control.
#
# Where to get these: Firebase Console > Project settings > General >
# "Your apps" > Web app > SDK setup and configuration > Config.
#
# If these are left empty, RoktoBondhu automatically runs in local DEMO MODE
# (data is stored only in this browser via localStorage, nothing is sent to
# any server). This lets you test the whole UI before Firebase is set up.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
